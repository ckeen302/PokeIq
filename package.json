{
  "name": "pokeiq",
  "version": "1.0.0",
  "private": true,
  "description": "Pok\u00e9IQ \u2014 the ultimate Pok\u00e9mon knowledge test: daily challenges, Pok\u00e9dle, Who's That Pok\u00e9mon, cries, Pok\u00e9dex entries, type matchups and an adaptive Pok\u00e9IQ rating.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx scripts/ingest-pokedex.ts && tsx scripts/ingest-details.ts",
    "ingest:world": "tsx scripts/ingest-world.ts",
    "verify:e2e": "node scripts/e2e-smoke.mjs",
    "connections:dailies": "tsx scripts/connections-dailies.ts",
    "pikadoku:dailies": "tsx scripts/pikadoku-dailies.ts",
    "lookalikes": "tsx scripts/silhouette-lookalikes.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "battle:sprites": "tsx scripts/battle-sprites.ts",
    "verify:showdown": "tsx scripts/showdown-parity.ts",
    "verify:quiz": "NODE_USE_ENV_PROXY=1 tsx scripts/quiz-verify.ts"
  },
  "dependencies": {
    "@pkmn/client": "0.7.3",
    "@pkmn/data": "0.10.11",
    "@pkmn/dex": "0.10.11",
    "@pkmn/protocol": "0.7.3",
    "@pkmn/sets": "5.2.0",
    "@pkmn/sim": "0.10.11",
    "@pkmn/view": "0.7.3",
    "@smogon/calc": "0.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.454.0",
    "next": "^15.1.0",
    "pokemon-showdown": "0.11.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@huggingface/transformers": "^3.8.1",
    "@pkmn/randoms": "0.10.11",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
