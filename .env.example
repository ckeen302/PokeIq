# Required in production: signs session/result/challenge tokens and derives
# question seeds. Any long random string, e.g. `openssl rand -base64 32`.
POKEIQ_SECRET=change-me-to-a-long-random-string

# Optional — Supabase (free tier). Without these the game runs fully; only
# leaderboards, cross-instance replay protection and difficulty calibration
# are disabled. The service role key is SERVER-ONLY: never prefix it with
# NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
