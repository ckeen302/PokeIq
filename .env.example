# Required in production: signs session/result/challenge tokens and derives
# question seeds. Any long random string, e.g. `openssl rand -base64 32`.
POKEIQ_SECRET=change-me-to-a-long-random-string

# Optional — Supabase (free tier). Without these the game runs fully; only
# leaderboards, cross-instance replay protection and difficulty calibration
# are disabled. The service role key is SERVER-ONLY: never prefix it with
# NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — live pushes over Supabase Realtime (chat rooms, PokéGuessr duels:
# the opponent's guess shows at once instead of at the next poll). The public
# anon key is sent to browsers; with these unset, pages poll instead.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — "Continue with Discord / Google" buttons (comma-separated; empty
# hides them). Needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY and the providers
# enabled in Supabase Auth. Defaults to both.
NEXT_PUBLIC_OAUTH_PROVIDERS=discord,google
